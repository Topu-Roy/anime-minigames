---
import Layout from "../../layouts/Layout.astro";
import "@fontsource/fredoka/400.css";
import "@fontsource/fredoka/500.css";
import "@fontsource/fredoka/600.css";
import "@fontsource/fredoka/700.css";
import { Characters } from "../../games/one-piece-draft/data/characters-v2";
import { calculateCharacterBST } from "../../games/one-piece-draft/lib/draft";
import F2SidewaysCard from "../../components/franchise/F2SidewaysCard.astro";
import type { FranchiseVerse } from "../../components/franchise/types";
import { LOGO_LOCKUP_URL } from "../../lib/brand";

// Same Cloudinary art as / (local avif files stay as upload source).
const FRANCHISE_ART = {
  onePiece:
    "https://res.cloudinary.com/nn2w9isf/image/upload/f_auto,q_auto/v1/anime-draft/franchise/one-piece?_a=BAMAROFG0",
  naruto:
    "https://res.cloudinary.com/nn2w9isf/image/upload/f_auto,q_auto/v1/anime-draft/franchise/naruto?_a=BAMAROFG0",
  hxh: "https://res.cloudinary.com/nn2w9isf/image/upload/f_auto,q_auto/v1/anime-draft/franchise/hunter-x-hunter?_a=BAMAROFG0",
  jjk: "https://res.cloudinary.com/nn2w9isf/image/upload/f_auto,q_auto/v1/anime-draft/franchise/jujutsu-kaisen?_a=BAMAROFG0",
};

// STYLE A - "Wanted Poster": parchment, thick ink outlines, hard sticker
// shadows, tilted badges. Peralta headings + Fredoka rounded body.

// Card showroom: strongest face on the roster fronts every variant.
const top1 = [...Characters]
  .map((c) => ({ name: c.displayName, imageURL: c.imageURL, bst: calculateCharacterBST(c) }))
  .sort((a, b) => b.bst - a.bst)[0];

// Franchise cards: one verse array drives the F2 render - copy lives
// here once, each verse maps into its own card.
const verses: FranchiseVerse[] = [
  {
    imageSrc: FRANCHISE_ART.onePiece,
    imageAlt: "Monkey D. Luffy - One Piece",
    kicker: "Live now",
    title: "One Piece",
    desc: "Draft game · blind ranking · 184 characters.",
    live: true,
    label: "WANTED",
    buttonText: "Set sail →",
  },
  {
    imageSrc: FRANCHISE_ART.naruto,
    imageAlt: "Naruto Uzumaki - Naruto",
    kicker: "Next · full effort",
    title: "Naruto",
    desc: "Draft yer shinobi. Jutsu, tailed beasts, live ranks.",
    live: false,
    label: "SEALED",
    buttonText: "Coming soon",
  },
  {
    imageSrc: FRANCHISE_ART.hxh,
    imageAlt: "Gon Freecss - Hunter x Hunter",
    kicker: "Next · full effort",
    title: "Hunter x Hunter",
    desc: "Draft yer hunter. Nen types, conditions, live ranks.",
    live: false,
    label: "HUNTED",
    buttonText: "Coming soon",
  },
  {
    imageSrc: FRANCHISE_ART.jjk,
    imageAlt: "Yuji Itadori - Jujutsu Kaisen",
    kicker: "Next · full effort",
    title: "Jujutsu Kaisen",
    desc: "Draft yer sorcerer. Cursed techniques, domains.",
    live: false,
    label: "CURSED",
    buttonText: "Coming soon",
  },
];

// Alternating tilts mirror the hand-placed look of the / route cards.
const tiltsB = ["rotate-[0.5deg]", "rotate-[-0.5deg]", "rotate-[-0.5deg]", "rotate-[0.5deg]"];
---

<Layout canonicalPath="/preview/a" description="Style preview A" noindex title="Style A - Wanted Poster">
  <style>
    .font-playful {
      font-family: "Fredoka", ui-rounded, system-ui, sans-serif;
    }
  </style>
  <div class="min-h-screen bg-[#f5e9d4] font-playful text-cocoa">
    <nav class="border-b-4 border-cocoa">
      <div class="mx-auto flex w-full max-w-5xl items-center justify-between px-6 py-4">
        <a class="shrink-0" href="/preview/a">
          <img alt="Anime Mini Games" class="h-10 w-auto" src={LOGO_LOCKUP_URL} />
        </a>
        <span
          class="rotate-2 rounded-lg border-3 border-cocoa bg-yellow px-3 py-1 text-xs font-bold tracking-widest uppercase"
        >
          Style A
        </span>
      </div>
    </nav>

    <main class="mx-auto w-full max-w-5xl px-6">
      <section class="py-14 text-center">
        <p
          class="inline-block -rotate-2 rounded-lg border-3 border-coral bg-white px-4 py-1 text-sm font-bold tracking-[0.2em] text-coral uppercase"
        >
          ★ Wanted ★ Dead or alive ★
        </p>
        <h1 class="mx-auto mt-6 max-w-2xl font-hand text-5xl leading-[1.05] text-cocoa sm:text-6xl">
          Draft yer own pirate!
        </h1>
        <p class="mx-auto mt-4 max-w-xl text-lg">
          Pick yer body, haki, Devil Fruit ’n weapon across 8 rounds - then see how yer scallywag ranks against all
          184 sea dogs!
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a
            class="rounded-2xl border-4 border-cocoa bg-coral px-8 py-4 text-xl font-bold text-white shadow-sticker-md active:translate-x-1 active:translate-y-1 active:shadow-none"
            href="/one-piece/draft"
          >
            ⚓ Start draftin'!
          </a>
          <a
            class="rounded-2xl border-4 border-cocoa bg-white px-8 py-4 text-xl font-bold shadow-sticker-md active:translate-x-1 active:translate-y-1 active:shadow-none"
            href="/one-piece/draft/how-to-play"
          >
            Read the map
          </a>
        </div>
      </section>

      <section
        class="mb-12 rotate-[-0.5deg] rounded-3xl border-4 border-cocoa bg-forest p-8 text-white shadow-sticker-lg md:p-10"
      >
        <div class="flex items-center gap-3">
          <span class="rounded-full bg-yellow px-3 py-1 text-xs font-bold tracking-widest text-cocoa uppercase">
            Bounty · 3,000,000,000
          </span>
        </div>
        <h2 class="mt-3 font-hand text-3xl sm:text-4xl">One Piece Draft Game</h2>
        <p class="mt-2 max-w-2xl">
          Eight rounds of plunderin’! Four scallywags per round - body, three haki, Devil Fruit, weapon, brains ’n
          battle smarts. Two rerolls, no take-backs!
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <span class="rounded-lg border-2 border-white/40 px-3 py-1 text-sm">🏴‍☠️ 184 donors</span>
          <span class="rounded-lg border-2 border-white/40 px-3 py-1 text-sm">🎲 2 rerolls</span>
          <span class="rounded-lg border-2 border-white/40 px-3 py-1 text-sm">👑 Live rank</span>
        </div>
        <a
          class="mt-6 inline-block rounded-2xl border-4 border-cocoa bg-yellow px-8 py-3 text-lg font-bold text-cocoa"
          href="/one-piece/draft"
        >
          Set sail →
        </a>
      </section>

      <section class="mx-auto mb-16 max-w-3xl">
        <h2 class="text-center font-hand text-3xl sm:text-4xl">Wanted sideways - W3 selected</h2>
        <p class="mt-2 text-center">Stamp overlap ships on /one-piece via GameModeCard.</p>

        <div class="mx-auto mt-8 max-w-xl">
          <!-- W3: stamp overlap - big WANTED stamp crashes over the art. -->
          <a
            class="flex rotate-[0.5deg] items-stretch gap-4 rounded-3xl border-4 border-cocoa bg-white p-4 shadow-sticker-lg"
            href="/one-piece/draft"
          >
            <div class="relative w-2/5 shrink-0 overflow-hidden rounded-2xl border-3 border-cocoa">
              <img
                alt={top1.name}
                class="absolute inset-0 h-full w-full object-cover object-top"
                loading="lazy"
                src={top1.imageURL}
              />
              <p
                class="absolute top-2 right-2 rotate-12 rounded-lg border-3 border-cocoa bg-coral px-2 py-1 font-hand text-base tracking-widest text-white"
              >
                WANTED
              </p>
            </div>
            <div class="flex min-w-0 flex-col justify-center py-1">
              <p class="text-xs font-bold tracking-[0.2em] text-cocoa/60 uppercase">Dead or alive</p>
              <h3 class="mt-1 font-hand text-2xl leading-[1.05] text-cocoa">Create the Strongest Character</h3>
              <span
                class="mt-3 inline-block w-fit rounded-2xl border-3 border-cocoa bg-coral px-6 py-2 text-base font-bold text-white shadow-sticker-sm"
              >
                Play →
              </span>
            </div>
          </a>
        </div>
      </section>

      <section class="mb-16">
        <h2 class="text-center font-hand text-3xl sm:text-4xl">Franchise cards - F2 selected</h2>
        <p class="mt-2 text-center">
          Sideways stamp ships on <span class="font-bold">/</span> Pick yer verse.
        </p>

        <!-- F2 · Sideways stamp - square art left (never stretched), type + button right. -->
        <p class="mt-6 text-center text-sm font-bold tracking-[0.2em] uppercase">F2 · Sideways stamp</p>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {
            verses.map((verse, index) => (
              <F2SidewaysCard
                {...verse}
                href={verse.live ? "/one-piece" : undefined}
                tiltClass={tiltsB[index % tiltsB.length]}
              />
            ))
          }
        </div>
      </section>

      <section class="mx-auto mb-16 max-w-3xl">
        <h2 class="text-center font-hand text-3xl sm:text-4xl">Tavern talk</h2>
        <div class="mt-6 flex flex-col gap-4">
          <details class="rounded-2xl border-3 border-cocoa bg-white px-5 py-4 shadow-sticker-sm">
            <summary class="cursor-pointer text-lg font-bold">Does Blackbeard have Conqueror's Haki?</summary>
            <p class="mt-2">
              Never shown! He brawls Yonko-tier on two Devil Fruits alone. Draft his Yami Yami no Mi 'n find out!
            </p>
          </details>
          <details class="rounded-2xl border-3 border-cocoa bg-white px-5 py-4 shadow-sticker-sm">
            <summary class="cursor-pointer text-lg font-bold">Who's strongest - Imu or Joy Boy?</summary>
            <p class="mt-2">Our ledger says Imu! Joy Boy's Nika keeps it closer than a barnacle, though.</p>
          </details>
        </div>
      </section>
    </main>

    <footer class="border-t-4 border-cocoa py-6 text-center text-sm">
      Style A preview · not indexed · <a class="underline" href="/">back to hub</a>
    </footer>
  </div>
</Layout>
