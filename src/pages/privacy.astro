---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.svelte";

// Privacy: static site, no accounts. GA4 for anonymous analytics + Cloudinary CDN. Last updated with GA launch.
const updated = "September 2026";
---

<Layout
  canonicalPath="/privacy"
  description="Anime Mini Games privacy policy — no accounts. Anonymous Google Analytics for traffic stats; draft progress lives in your browser; images served via Cloudinary."
  title="Privacy Policy | AnimeMiniGames"
>
  <NavBar client:load showRestart={false} />

  <div class="bg-paper text-cocoa">
    <main class="mx-auto w-full max-w-3xl px-6 py-12 md:py-16">
      <p class="text-xs font-bold tracking-wide text-cocoa/60 uppercase">
        <a class="text-coral underline" href="/">Anime Mini Games</a> · Privacy
      </p>
      <h1 class="mt-2 font-hand text-4xl leading-[1.05] sm:text-5xl">Privacy policy</h1>
      <p class="mt-4 text-lg leading-relaxed">
        Short version: no accounts, no sign-ups. We run anonymous Google Analytics to see which games get played —
        no ad tracking, no cross-site profiling. Last updated {updated}.
      </p>

      <h2 class="mt-12 mb-4 font-hand text-3xl sm:text-4xl">What stays in yer browser</h2>
      <div class="flex flex-col gap-3 leading-relaxed">
        <p>
          Draft picks, rankings and game progress live only in your browser's memory and local storage. Close the
          tab and it vanishes — we never see it, store it, or send it anywhere.
        </p>
      </div>

      <h2 class="mt-12 mb-4 font-hand text-3xl sm:text-4xl">Analytics</h2>
      <div class="flex flex-col gap-3 leading-relaxed">
        <p>
          We use Google Analytics 4 (measurement ID G-7BGSVX7GR0) to count page visits and see which games are
          popular. It sets its own cookies (such as _ga), anonymizes IP addresses, and processes data under
          Google's policy. No game progress or personal data is sent to Analytics — drafts stay in your browser
          only.
        </p>
        <p>
          Prefer out? Install the
          <a
            class="font-bold text-coral underline"
            href="https://tools.google.com/dlpage/gaoptout"
            rel="noopener"
            target="_blank">Google Analytics opt-out add-on</a
          >, or block third-party cookies in your browser — the games keep working either way.
        </p>
      </div>

      <h2 class="mt-12 mb-4 font-hand text-3xl sm:text-4xl">Third-party services</h2>
      <div class="flex flex-col gap-3 leading-relaxed">
        <p>
          Character and card art loads from Cloudinary's CDN, which may log standard request data (such as IP
          address) under its own policy. Analytics scripts load from Google Tag Manager's CDN under the policy
          above.
        </p>
      </div>

      <h2 class="mt-12 mb-4 font-hand text-3xl sm:text-4xl">Contact about privacy</h2>
      <div class="flex flex-col gap-3 leading-relaxed">
        <p>
          Questions or requests about your data? Write to
          <a class="font-bold text-coral underline" href="mailto:hello@animeminigames.com"
            >hello@animeminigames.com</a
          > — there is little we hold, but we answer everything.
        </p>
      </div>

      <a
        class="mt-12 inline-block rounded-2xl border-4 border-cocoa bg-coral px-8 py-4 text-xl font-bold text-white shadow-sticker-md active:translate-x-1 active:translate-y-1 active:shadow-none"
        href="/"
      >
        ⚓ Back to the games
      </a>
    </main>
  </div>
</Layout>
