---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.svelte";

// Terms: fan games, browser-local progress, fair-use respect, no warranties.
const updated = "September 2026";
---

<Layout
  canonicalPath="/terms"
  description="Anime Mini Games terms — free unofficial fan minigames. Browser-local progress, fair-use fan content, no warranties."
  title="Terms and Conditions | AnimeMiniGames"
>
  <NavBar showRestart={false} />

  <div class="bg-paper text-cocoa">
    <main class="mx-auto w-full max-w-3xl px-6 py-12 md:py-16">
      <p class="text-xs font-bold tracking-wide text-cocoa/60 uppercase">
        <a class="text-coral underline" href="/">Anime Mini Games</a> · Terms
      </p>
      <h1 class="mt-2 font-hand text-4xl leading-[1.05] sm:text-5xl">Terms and conditions</h1>
      <p class="mt-4 text-lg leading-relaxed">
        The rules of the ship. By playing, ye agree to the below. Last updated {updated}.
      </p>

      <h2 class="mt-12 mb-4 font-hand text-3xl sm:text-4xl">The games</h2>
      <div class="flex flex-col gap-3 leading-relaxed">
        <p>
          Anime Mini Games offers free unofficial fan minigames. No accounts, no purchases, no prizes. Progress
          lives in your browser and may vanish any time — that is by design, not a bug.
        </p>
      </div>

      <h2 class="mt-12 mb-4 font-hand text-3xl sm:text-4xl">Fan content and fair use</h2>
      <div class="flex flex-col gap-3 leading-relaxed">
        <p>
          All anime, characters and artwork belong to their respective owners. Stats, ranks and guides are
          transformative fan commentary for play. If you hold rights and want something changed, write to
          <a class="font-bold text-coral underline" href="mailto:hello@animeminigames.com"
            >hello@animeminigames.com</a
          > and it will be handled promptly.
        </p>
      </div>

      <h2 class="mt-12 mb-4 font-hand text-3xl sm:text-4xl">Fair play</h2>
      <div class="flex flex-col gap-3 leading-relaxed">
        <p>
          Play fair: no scraping the roster data at abusive rates, no attacking the site, no pretending to be the
          crew. Automated bulk copying of game data is not permitted.
        </p>
      </div>

      <h2 class="mt-12 mb-4 font-hand text-3xl sm:text-4xl">No warranties</h2>
      <div class="flex flex-col gap-3 leading-relaxed">
        <p>
          Games are provided as-is, without warranties of any kind. Ranks are for fun and settle no real debates —
          no matter what yer crew claims.
        </p>
      </div>

      <a
        class="mt-12 inline-block rounded-2xl border-4 border-cocoa bg-coral px-8 py-4 text-xl font-bold text-white shadow-sticker-md active:translate-x-1 active:translate-y-1 active:shadow-none"
        href="/"
      >
        ⚓ Back to the games
      </a>
    </main>
  </div>
</Layout>
