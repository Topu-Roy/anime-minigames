---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.svelte";

// Dead-end route: never indexed, always an exit back to playable pages.
---

<Layout
  canonicalPath="/404"
  description="Lost at sea - this page does not exist. Head back to free anime minigames."
  noindex
  title="Lost at Sea - Page Not Found | AnimeMiniGames"
>
  <NavBar client:load showRestart={false} />

  <div class="bg-paper text-cocoa">
    <main class="mx-auto w-full max-w-2xl px-6 py-16 text-center md:py-24">
      <p
        class="inline-block -rotate-2 rounded-lg border-3 border-cocoa bg-yellow px-4 py-1 text-sm font-bold tracking-[0.2em] text-cocoa uppercase"
      >
        404
      </p>
      <h1 class="mx-auto mt-6 font-hand text-5xl leading-[1.05] sm:text-6xl">Lost at sea</h1>
      <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-cocoa/80">
        This page drifted off the map. The games are still here - pick a port below and keep playing.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          class="rounded-2xl border-4 border-cocoa bg-coral px-8 py-4 text-xl font-bold text-white shadow-sticker-md active:translate-x-1 active:translate-y-1 active:shadow-none"
          href="/"
        >
          Back home →
        </a>
        <a
          class="rounded-2xl border-4 border-cocoa bg-white px-8 py-4 text-xl font-bold text-cocoa shadow-sticker-md active:translate-x-1 active:translate-y-1 active:shadow-none"
          href="/one-piece"
        >
          One Piece games →
        </a>
      </div>
    </main>
  </div>
</Layout>
