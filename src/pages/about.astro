---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.svelte";

// Brand story: what the hub is, what's live, what's next. Feeds /one-piece.
---

<Layout
  canonicalPath="/about"
  description="About Anime Mini Games — free anime minigames in your browser. Draft and rank custom fighters from One Piece, with Naruto, Hunter x Hunter and Jujutsu Kaisen games next."
  title="About | AnimeMiniGames"
>
  <NavBar client:load showRestart={false} />

  <div class="bg-paper text-cocoa">
    <main class="mx-auto w-full max-w-3xl px-6 py-12 md:py-16">
      <p class="text-xs font-bold tracking-wide text-cocoa/60 uppercase">
        <a class="text-coral underline" href="/">Anime Mini Games</a> · About
      </p>
      <h1 class="mt-2 font-hand text-4xl leading-[1.05] sm:text-5xl">About the crew</h1>
      <p class="mt-4 text-lg leading-relaxed">
        Anime Mini Games is a free anime minigames hub. You build original fighters from canon donors and rank them
        against full rosters — five minutes a game, no download, no account.
      </p>

      <h2 class="mt-12 mb-4 font-hand text-3xl sm:text-4xl">What sails today</h2>
      <div class="flex flex-col gap-3 leading-relaxed">
        <p>
          The <a class="font-bold text-coral underline" href="/one-piece">One Piece games</a> are live: an 8-round <a
            class="font-bold text-coral underline"
            href="/one-piece/draft">draft game</a
          > across 184 canon-graded characters, plus <a
            class="font-bold text-coral underline"
            href="/one-piece/blind-rank">blind top-10 ranking</a
          >. Character guides and haki answers round out the hub.
        </p>
        <p>
          Naruto, Hunter x Hunter and Jujutsu Kaisen games are charted next — each with the same effort as One
          Piece: a full draft game, live rankings and character guides.
        </p>
      </div>

      <h2 class="mt-12 mb-4 font-hand text-3xl sm:text-4xl">Fan-made waters</h2>
      <div class="flex flex-col gap-3 leading-relaxed">
        <p>
          Anime Mini Games is an unofficial fan project with no affiliation to any rights holder. All series ©
          their respective owners. Stats are feat-graded opinions for play, not official canon.
        </p>
      </div>

      <a
        class="mt-12 inline-block rounded-2xl border-4 border-cocoa bg-coral px-8 py-4 text-xl font-bold text-white shadow-sticker-md active:translate-x-1 active:translate-y-1 active:shadow-none"
        href="/one-piece"
      >
        ⚓ Meet the games
      </a>
    </main>
  </div>
</Layout>
