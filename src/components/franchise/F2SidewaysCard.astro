---
import type { FranchiseVerse } from "./types";

// F2 · Sideways stamp - square MC art left with LIVE/SOON stamp, type +
// button right. Art keeps its own square (self-center), never stretched
// to the text column - that stretch cropped Gon/Yuji chins.
type Props = FranchiseVerse;

const {
  imageSrc,
  imageAlt,
  kicker,
  title,
  desc,
  label,
  live,
  href,
  tiltClass = "rotate-[0.5deg]",
  buttonText = "Set sail →",
} = Astro.props;

// Whole-card link only when an href is passed; otherwise plain <div>.
const Tag = href ? "a" : "div";
---

<Tag
  {...href ? { href } : {}}
  class:list={[
    "flex items-stretch gap-4 rounded-3xl border-4 p-4",
    tiltClass,
    {
      "border-cocoa bg-white shadow-sticker-lg active:translate-x-1 active:translate-y-1 active:shadow-none": live,
      "border-cocoa/40 bg-white": !live,
    },
  ]}
>
  <div
    class:list={[
      "relative w-2/5 shrink-0 self-center overflow-hidden rounded-2xl border-3",
      { "border-cocoa": live, "border-cocoa/40": !live },
    ]}
  >
    <img
      alt={imageAlt}
      class="aspect-square h-auto w-full object-cover object-top"
      loading="lazy"
      src={imageSrc}
    />
    <p
      class:list={[
        "absolute top-0 -right-2 rotate-12 rounded-lg border-3 px-2 py-1 font-hand text-base tracking-widest",
        { "border-cocoa bg-coral text-white": live, "border-cocoa/40 bg-white text-cocoa/50": !live },
      ]}
    >
      {label}
    </p>
  </div>

  <div class="flex flex-1 flex-col justify-center py-1">
    <div class="flex-1">
      <p
        class:list={[
          "text-xs font-bold tracking-[0.2em] uppercase",
          { "text-coral": live, "text-cocoa/50": !live },
        ]}
      >
        {kicker}
      </p>
      <h3 class="mt-1 font-hand text-2xl leading-[1.05] text-cocoa">{title}</h3>
      <p class="mt-1 text-sm text-cocoa/70">{desc}</p>
    </div>

    <span
      class:list={[
        "mt-3 inline-block w-fit rounded-2xl border-3 px-6 py-2 text-base font-bold",
        {
          "border-cocoa bg-yellow text-cocoa shadow-sticker-sm": live,
          "border-cocoa/40 bg-white text-cocoa/50": !live,
        },
      ]}
    >
      {buttonText}
    </span>
  </div>
</Tag>
