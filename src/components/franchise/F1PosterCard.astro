---
import type { FranchiseVerse } from "./types";

// F1 · Poster stack - square MC art on top, LIVE/SOON stamp, type +
// sticker button below. Art is always a true square (sources are 1:1),
// so faces never crop.
type Props = FranchiseVerse;

const {
  imageSrc,
  imageAlt,
  kicker,
  title,
  desc,
  live,
  href,
  label = live ? "LIVE" : "SOON",
  tiltClass = "rotate-[-0.5deg]",
  buttonText = "Set sail →",
} = Astro.props;

// Whole-card link only when an href is passed; otherwise plain <div>.
const Tag = href ? "a" : "div";
---

<Tag
  {...href ? { href } : {}}
  class:list={[
    "block overflow-hidden rounded-3xl border-4 shadow-[8px_8px_0_#3a2a18]",
    tiltClass,
    { "border-cocoa bg-white": live, "border-cocoa/40 bg-white": !live },
    { "active:translate-x-1 active:translate-y-1 active:shadow-none": href },
  ]}
>
  <div class="relative">
    <img alt={imageAlt} class="aspect-square w-full object-cover object-top" loading="lazy" src={imageSrc} />
    <p
      class:list={[
        "absolute top-2 -right-2 rotate-12 rounded-lg border-[3px] px-2 py-1 font-hand text-base tracking-widest",
        { "border-cocoa bg-coral text-white": live, "border-cocoa/40 bg-white text-cocoa/50": !live },
      ]}
    >
      {label}
    </p>
  </div>
  <div class="p-5">
    <p
      class:list={[
        "text-[11px] font-bold tracking-[0.3em] uppercase",
        { "text-coral": live, "text-cocoa/50": !live },
      ]}
    >
      {kicker}
    </p>
    <h3 class="mt-1 font-hand text-3xl text-cocoa">{title}</h3>
    <p class="mt-1 text-sm text-cocoa/70">{desc}</p>
    {
      live && (
        <span class="mt-3 inline-block rounded-2xl border-[3px] border-cocoa bg-yellow px-6 py-2 text-base font-bold text-cocoa shadow-[4px_4px_0_#3a2a18]">
          {buttonText}
        </span>
      )
    }
  </div>
</Tag>
