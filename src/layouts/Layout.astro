---
/*
 * Type runs the Haas-substitute system stack (see global.css).
 * Peralta is loaded for card names only - game flavor
 * against the calm editorial body.
 */
import "@fontsource/peralta/400.css";
import "@fontsource/fredoka/400.css";
import "@fontsource/fredoka/500.css";
import "@fontsource/fredoka/600.css";
import "@fontsource/fredoka/700.css";
import "../styles/global.css";
import { LOGO_MARK_URL } from "../lib/brand";
import pkg from "../../package.json";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  // Style previews and utility pages opt out of the index.
  noindex?: boolean;
}

// Live domain - single constant feeds canonical + OG URLs site-wide.
const SITE = "https://animeminigames.com";
const BACKDROP_OG =
  "https://res.cloudinary.com/nn2w9isf/image/upload/f_auto,q_auto/v1/anime-draft/ancient_bg?_a=BAMAROFG0";

const {
  title = "AnimeMiniGames - Free One Piece Minigames",
  description = "AnimeMiniGames is a free One Piece minigame hub. Draft your own pirate from 184 characters, rank the strongest, and play more games.",
  canonicalPath = "/",
  ogImage = BACKDROP_OG,
  noindex = false,
} = Astro.props;
const canonical = `${SITE}${canonicalPath}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <link href="/favicon-96x96.png" rel="icon" sizes="96x96" type="image/png" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <link href="/favicon.ico" rel="shortcut icon" />
    <link href="/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180" />
    <link href="/site.webmanifest" rel="manifest" />
    <meta content={Astro.generator} name="generator" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <link href={canonical} rel="canonical" />
    {noindex && <meta content="noindex, nofollow" name="robots" />}
    <meta content="#181d26" name="theme-color" />
    <meta content="website" property="og:type" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={canonical} property="og:url" />
    <meta content={ogImage} property="og:image" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={ogImage} name="twitter:image" />
    <!-- Google Analytics 4 via Partytown (web worker - zero main-thread cost).
         Single injection point: every page renders through this Layout.
         Init lives in /gtag-init.js (external file keeps
         astro/no-unsafe-inline-scripts clean; runs in worker via Partytown). -->
    <script src="https://www.googletagmanager.com/gtag/js?id=G-7BGSVX7GR0" type="text/partytown"></script>
    <script src="/gtag-init.js" type="text/partytown"></script>
  </head>
  <body class="font-playful">
    <slot />
    <footer class="w-full border-t-4 border-cocoa bg-paper">
      <div
        class="mx-auto flex w-full max-w-5xl flex-col items-center gap-3 px-6 py-6 text-center text-xs font-bold tracking-wide text-cocoa/70 min-[850px]:flex-row min-[850px]:justify-between min-[850px]:gap-2 min-[850px]:text-left"
      >
        <span class="flex shrink-0 items-center gap-2 whitespace-nowrap">
          <img alt="Anime Mini Games" class="h-8 w-auto" src={LOGO_MARK_URL} />
          <span>AnimeMiniGames · v{pkg.version}</span>
        </span>
        <nav
          aria-label="Site"
          class="flex flex-wrap items-center justify-center gap-x-1 gap-y-1 min-[850px]:gap-x-4"
        >
          <a class="px-2 py-1.5 underline" href="/about">About</a>
          <a class="px-2 py-1.5 underline" href="/privacy">Privacy</a>
          <a class="px-2 py-1.5 underline" href="/terms">Terms</a>
          <a class="px-2 py-1.5 underline" href="/contact">Contact</a>
        </nav>
        <span class="max-w-md min-[850px]:max-w-none"
          >Unofficial fan project. All series © their respective owners.</span
        >
      </div>
    </footer>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
